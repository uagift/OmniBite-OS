# Supa Menu Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Settings (MySQL/PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_password
DB_NAME=supa_menu_db

# Security
JWT_SECRET=super_secret_jwt_sign_key_98231!
JWT_EXPIRES_IN=24h

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_username@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM="Supa Menu Support" <support@supamenu.com>
